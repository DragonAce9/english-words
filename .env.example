BOT_TOKEN=123456:replace-me
# Public bot username (no @). Used for t.me deep links like ?start=support
BOT_USERNAME=YOUR_BOT_USERNAME
# Support inbox: messages from /support are delivered to this Telegram user.
# Always prefer the numeric id. Telegram getChat/sendMessage(@YOUR_SUPPORT_USERNAME) returns
# "chat not found" for private users even after they /start this bot — bots
# cannot address a private chat by username. The bot learns the id from any
# update whose from.username matches SUPPORT_TELEGRAM_USERNAME and writes
# SUPPORT_TELEGRAM_USER_ID here. Do not invent an id.
# SUPPORT_TELEGRAM_USER_ID=
SUPPORT_TELEGRAM_USERNAME=YOUR_SUPPORT_USERNAME
# Telegram Mini App URL. Must be public HTTPS for the bot Web App button.
# URL Mini App. Для кнопки Telegram нужен публичный HTTPS.
# Local browser / локальный браузер: http://localhost:3000
# Named tunnel / именованный туннель (стабильный hostname в Cloudflare):
#   WEBAPP_URL=https://app.your-domain.com
# Quick trycloudflare (URL меняется при каждом рестарте tunnel):
#   docker compose up -d --build && docker compose logs -f tunnel
#   скопируй https://xxxx.trycloudflare.com сюда, затем: docker compose up -d api
WEBAPP_URL=https://app.your-domain.com
DATABASE_URL=postgres://english:english@localhost:5433/english
TRIBUTE_API_KEY=dev-tribute-key
# Digital product IDs from Tribute Creator Dashboard (Цифровые товары)
TRIBUTE_PRODUCT_MONTHLY_ID=1001
TRIBUTE_PRODUCT_YEARLY_ID=1002
# Explicit Tribute checkout links (preferred over telegram.me startapp fallback)
TRIBUTE_SUBSCRIBE_URL=https://web.tribute.tg/p/YOUR_MONTHLY_PRODUCT
TRIBUTE_SUBSCRIBE_YEARLY_URL=https://web.tribute.tg/p/YOUR_YEARLY_PRODUCT
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Telegram channel for Moti's posts (@name or -100…). Empty skips the post.
# Канал для ежедневного факта. Пусто — в канал ничего не отправляется.
FACT_CHANNEL_ID=@YOUR_CHANNEL_USERNAME
# Optional: only for `npm run import:media -- --tmdb …`
TMDB_API_KEY=
# Optional: fetch English .srt in `import:media` when --srt is omitted
# Consumer key: https://www.opensubtitles.com/en/consumers (not the site password)
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=
OPENSUBTITLES_USER_AGENT=EnglishWords v1.0
ALLOW_DEV_AUTH=true
DEV_TELEGRAM_USER_ID=1
PORT=3000
DICTIONARY_DIR=../../data/themes
MIGRATIONS_DIR=../../migrations
WEB_DIST=../web/dist
NODE_ENV=development
# PostHog project API key. Baked into the Mini App at `npm run build` / image build.
# Empty disables analytics. Host must match the project region.
# EU: https://eu.i.posthog.com   US: https://us.i.posthog.com
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com
PET_SUFFER_HOURS=72
# Cloudflare Tunnel (compose service `tunnel`). Token = только eyJ… из Docker-команды
# в дашборде, не весь `docker run`. Не коммить настоящий токен.
# Named / именованный (стабильный HTTPS): вставь токен и раскомментируй CMD = run.
# Empty token / пустой токен: quick trycloudflare на http://api:3000.
TUNNEL_TOKEN=
# CLOUDFLARED_CMD=tunnel --no-autoupdate run
